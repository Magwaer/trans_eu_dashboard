# App
PORT=4000
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
DASHBOARD_PASSWORD=ops

# PostgreSQL
DATABASE_URL=postgres://transeu:transeu@localhost:5433/transeu

# Trans.eu OAuth (register at https://www.trans.eu/api/)
TRANS_CLIENT_ID=
TRANS_CLIENT_SECRET=
TRANS_API_KEY=
TRANS_REDIRECT_URI=http://localhost:4000/api/auth/trans/callback
TRANS_AUTH_URL=https://auth.platform.trans.eu/oauth2/auth
TRANS_TOKEN_URL=https://api.platform.trans.eu/ext/auth-api/accounts/token
TRANS_API_BASE=https://api.platform.trans.eu
# Public URL Trans.eu will POST callbacks to (must be reachable, allow IP 52.208.90.151)
TRANS_CALLBACK_URL=http://localhost:4000/api/webhooks/trans

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Sync
SYNC_INTERVAL_SECONDS=90
AUTOMATION_ENABLED=true
SEED_DEMO_DATA=true
